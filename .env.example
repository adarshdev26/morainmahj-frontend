# morainmahj-backend API. Vite is configured to expose both the REACT_APP_ and
# VITE_ prefixes, so either name works; keep them pointing at the same host.
#
# Local development: leave both empty. The app then requests /api on its own
# origin and the Vite dev server proxies that to VITE_DEV_API_PROXY below. This
# matches how Nginx serves the app in production, and because the requests are
# same-origin the browser sends no CORS preflight — one request per call instead
# of two.
REACT_APP_API_URL=
VITE_API_URL=
VITE_DEV_API_PROXY=http://localhost:3000

# Production: use the full https origin. Since Nginx serves the site from that
# same domain, requests are still same-origin and still preflight-free, and the
# one build output also works for the Capacitor apps — those load from
# capacitor://localhost (iOS) and http://localhost (Android), where a relative
# URL would resolve to the device itself and every request would fail.
#
#   REACT_APP_API_URL=https://morainmahj.com
#   VITE_API_URL=https://morainmahj.com
#
# These are inlined at build time, not read at runtime, so changing them means
# rebuilding and redeploying the frontend.

# When true, "/" redirects to /dashboard if a token is stored and /login if not.
# Set to false to restore the original marketing landing page at "/".
VITE_AUTH_ROOT_REDIRECT=true
